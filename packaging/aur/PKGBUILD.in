# Maintainer: Metamorfolog <https://github.com/Metamorfolog>
# Generated by CI from packaging/aur/PKGBUILD.in – edit the template, not the AUR copy.
pkgname=dropit-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Convert files by dropping them on a radial wheel: images, audio, video, PDF, documents, spreadsheets, archives"
arch=('x86_64')
url="https://github.com/BrO-ken/Dropit"
license=('@LICENSE@')
depends=('glibc' 'gcc-libs' 'zlib' 'icu' 'openssl' 'fontconfig' 'libx11' 'libxi' 'libxrandr' 'libxcursor' 'libice' 'libsm')
optdepends=(
  'ffmpeg: audio and video conversions'
    'pandoc-cli: document conversions (DOCX, Markdown, EPUB, etc.)'
  'libreoffice-fresh: Office files and export to PDF'
  'tesseract: extract text from images (OCR)'
  'tesseract-data-eng: English OCR'
    'tesseract-data-ara: Arabic OCR'
)
provides=('dropit')
conflicts=('dropit')
options=('!strip' '!debug')
source=("@SOURCE@")
sha256sums=('@SHA256@')

package() {
  install -d "$pkgdir/opt/dropit" "$pkgdir/usr/bin"
  cp -a dropit/app/. "$pkgdir/opt/dropit/"
  ln -s /opt/dropit/dropit "$pkgdir/usr/bin/dropit"
  install -Dm644 dropit/share/dropit.desktop "$pkgdir/usr/share/applications/dropit.desktop"
  install -Dm644 dropit/share/dropit.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/dropit.png"
  install -Dm755 dropit/share/dolphin-servicemenu.desktop "$pkgdir/usr/share/kio/servicemenus/dropit.desktop"
  install -Dm644 dropit/share/dropit.nemo_action "$pkgdir/usr/share/nemo/actions/dropit.nemo_action"
  install -Dm644 dropit/share/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 dropit/share/THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
}
